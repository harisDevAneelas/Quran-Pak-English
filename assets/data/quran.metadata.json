  "para": [
    {
      "para": 1,
      "name": "الٓمٓ"
    },
    {
      "para": 2,
      "name": "سَيَقُولُ"
    },
    {
      "para": 3,
      "name": "تِلْكَ ٱلرُّسُلُ"
    },
    {
      "para": 4,
      "name": "لَن تَنَالُوا"
    },
    {
      "para": 5,
      "name": "وَٱلْمُحْصَنَـٰتُ"
    },
    {
      "para": 6,
      "name": "لَّا يُحِبُّ ٱللَّهُ"
    },
    {
      "para": 7,
      "name": "وَإِذَا سَمِعُوا"
    },
    {
      "para": 8,
      "name": "وَلَوْ أَنَّنَا"
    },
    {
      "para": 9,
      "name": "قَالَ ٱلْمَلَأُ"
    },
    {
      "para": 10,
      "name": "وَٱعْلَمُوٓا"
    },
    {
      "para": 11,
      "name": "يَعْتَذِرُونَ"
    },
    {
      "para": 12,
      "name": "وَمَا مِن دَآبَّةٍ"
    },
    {
      "para": 13,
      "name": "وَمَآ أُبَرِّئُ"
    },
    {
      "para": 14,
      "name": "رُّبَمَا"
    },
    {
      "para": 15,
      "name": "سُبْحَـٰنَ ٱلَّذِىٓ"
    },
    {
      "para": 16,
      "name": "قَالَ أَلَمْ"
    },
    {
      "para": 17,
      "name": "ٱقْتَرَبَ"
    },
    {
      "para": 18,
      "name": "قَدْ أَفْلَحَ"
    },
    {
      "para": 19,
      "name": "وَقَالَ ٱلَّذِينَ"
    },
    {
      "para": 20,
      "name": "أَمَّنْ خَلَقَ"
    },
    {
      "para": 21,
      "name": "ٱتْلُ مَآ أُوحِىَ"
    },
    {
      "para": 22,
      "name": "وَمَن يَقْنُتْ"
    },
    {
      "para": 23,
      "name": "وَمَا لِىَ"
    },
    {
      "para": 24,
      "name": "فَمَنْ أَظْلَمُ"
    },
    {
      "para": 25,
      "name": "إِلَيْهِ يُرَدُّ"
    },
    {
      "para": 26,
      "name": "حمٓ"
    },
    {
      "para": 27,
      "name": "قَالَ فَمَا خَطْبُكُمْ"
    },
    {
      "para": 28,
      "name": "قَدْ سَمِعَ ٱللَّهُ"
    },
    {
      "para": 29,
      "name": "تَبَـٰرَكَ ٱلَّذِى"
    },
    {
      "para": 30,
      "name": "عَمَّ يَتَسَآءَلُونَ"
    }
  ],
